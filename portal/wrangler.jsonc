{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "samyak-student-portal",
  "compatibility_date": "2026-07-21",
  "main": "worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD_9LJVUBqi8lIkK"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samyak-student-portal",
      "database_id": "fe9beb06-7c41-43ff-a475-2e345d48dbad"
    }
  ]
}
