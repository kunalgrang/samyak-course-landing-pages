{
  "name": "samyak-student-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ./scripts/build-without-local-dev-vars.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "contact-recovery:payload": "node --experimental-strip-types --experimental-specifier-resolution=node ./scripts/generate-contact-recovery-payload.ts",
    "import:legacy-students": "node --experimental-strip-types --experimental-specifier-resolution=node ./worker/lib/legacy-import-cli.ts",
    "smoke:production": "node ./scripts/smoke-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply samyak-student-portal --local",
    "db:migrate:remote": "wrangler d1 migrations apply samyak-student-portal --remote",
    "db:seed:local": "wrangler d1 execute samyak-student-portal --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute samyak-student-portal --remote --file=./seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "happy-dom": "^20.11.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.115.0"
  }
}
